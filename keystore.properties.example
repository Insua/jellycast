# 复制本文件为 keystore.properties 并填入真实值。
# keystore.properties 已被 .gitignore 排除 —— 真实密码绝不进版本库。
#
# 还没有 keystore?这样生成:
#   keytool -genkeypair -v \
#     -keystore ~/.android/keystores/jellycast.jks \
#     -alias jellycast -keyalg RSA -keysize 4096 \
#     -validity 10000 -storetype PKCS12
#
# 没有本文件时构建不会失败:release 会退回未签名产物,debug 照常用 Android 默认调试密钥。

storeFile=/absolute/path/to/jellycast.jks
storePassword=changeme
keyAlias=jellycast
keyPassword=changeme
